{
  "name": "notebook-transcriber",
  "version": "0.1.0",
  "private": true,
  "description": "Hebrew notebook transcriber: read pages aloud, get clean text",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node build.mjs && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --mac dir"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "productName": "Notebook Transcriber",
  "build": {
    "appId": "local.notebook-transcriber",
    "productName": "Notebook Transcriber",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Notebook Transcriber records you reading your notebook pages aloud, to transcribe them."
      }
    }
  }
}
